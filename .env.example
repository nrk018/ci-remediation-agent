GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=change-me
OPENAI_API_KEY=
# Local Postgres. For Amazon RDS, use the instance endpoint and require SSL:
# postgresql://ciadmin:PASSWORD@your-db.xxxx.ap-south-1.rds.amazonaws.com:5432/ci_remediation?sslmode=require
DATABASE_URL=postgresql://ci:ci@localhost:5432/ci_remediation
# Harness personal access token (pat...). This authenticates Harness API calls.
# It is not an LLM key. The free-tier $5 model budget is spent only by Worker Agents inside Harness.
HARNESS_API_TOKEN=
HARNESS_ACCOUNT_ID=
HARNESS_BASE_URL=https://app.harness.io
CONFIDENCE_THRESHOLD=0.35
SIMILARITY_FLOOR=0.35
RETRY_CAP=2
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Set to 1 to force local hashing embeddings even when OPENAI_API_KEY is present.
CI_REMEDIATION_OFFLINE=0
